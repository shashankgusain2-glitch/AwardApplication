# Copy this file to .env and change the values.
# Never commit .env — it is in .gitignore.

# Which settings to use: config.settings.dev (default), .test or .prod
DJANGO_SETTINGS_MODULE=config.settings.dev

# Turn off in production.
DEBUG=True

# Any long random string (32+ characters). Required in production.
SECRET_KEY=change-me-to-a-long-random-string-of-at-least-32-chars

# Comma-separated host names the app may be served on. Required in production.
ALLOWED_HOSTS=localhost,127.0.0.1

# PostgreSQL connection (matches docker-compose.yml).
# For a quick start without PostgreSQL, use: sqlite:///db.sqlite3
DATABASE_URL=postgres://awards:awards@localhost:5432/awards

# --- API -------------------------------------------------------------------
# Key used to sign JWTs (32+ characters). Defaults to SECRET_KEY.
JWT_SIGNING_KEY=
JWT_ACCESS_MINUTES=30
JWT_REFRESH_DAYS=1

# Frontend origins allowed to call the API (comma-separated).
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# Rate limits
THROTTLE_ANON=60/minute
THROTTLE_USER=1000/hour
THROTTLE_LOGIN=10/minute
# Local development only (config/settings/dev.py): enough for a full Postman run
THROTTLE_LOGIN_DEV=60/minute

# --- Email -----------------------------------------------------------------
# Console backend prints emails instead of sending them (demo).
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=awards@awards.example

# --- Logging ---------------------------------------------------------------
LOG_LEVEL=INFO

# --- Demo data ---------------------------------------------------------------
# Password given to the demo accounts created by `python manage.py seed_data`
# (test accounts only; change or remove for any real deployment).
DEMO_PASSWORD=Awards-Demo-2026
