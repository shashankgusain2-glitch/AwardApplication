# Production environment: copy to .env.production on the server (never commit the real one).
# Every value here is a placeholder. Generate secrets with:
#   python -c "import secrets; print(secrets.token_urlsafe(50))"

DJANGO_SETTINGS_MODULE=config.settings.prod
SECRET_KEY=replace-with-a-50-character-random-secret
JWT_SIGNING_KEY=replace-with-a-different-32-plus-character-secret
ALLOWED_HOSTS=awards.example.org
CSRF_TRUSTED_ORIGINS=https://awards.example.org
# Empty: the web pages are on the same domain. Add a frontend origin only if a separate SPA is built.
CORS_ALLOWED_ORIGINS=

# Managed PostgreSQL (require TLS)
DATABASE_URL=postgres://USER:PASSWORD@HOST:5432/awards?sslmode=require
CONN_MAX_AGE=60

# Tokens and rate limits
JWT_ACCESS_MINUTES=15
JWT_REFRESH_DAYS=1
THROTTLE_ANON=60/minute
THROTTLE_USER=1000/hour
THROTTLE_LOGIN=10/minute

# HTTPS (keep True behind a proxy that sends X-Forwarded-Proto)
SECURE_SSL_REDIRECT=True
SECURE_HSTS_SECONDS=2592000
SECURE_HSTS_PRELOAD=False

# Email (SMTP: Amazon SES, Postmark, SendGrid…)
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=email-smtp.ap-south-1.amazonaws.com
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=awards@awards.example.org
SITE_URL=https://awards.example.org

# Uploaded files: an S3-compatible bucket (leave the bucket empty to use the local media folder)
AWS_STORAGE_BUCKET_NAME=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_REGION_NAME=ap-south-1
AWS_S3_ENDPOINT_URL=

# Error tracking
SENTRY_DSN=
SENTRY_ENVIRONMENT=production
SENTRY_TRACES_SAMPLE_RATE=0.1

LOG_LEVEL=INFO

# Never set DEMO_PASSWORD here, and never run seed_data in production.
